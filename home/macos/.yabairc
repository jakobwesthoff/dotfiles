#!/usr/bin/env sh

yabai -m config                                 \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    window_origin_display        default        \
    window_placement             second_child   \
    window_animation_duration    0.0            \
    window_opacity_duration      0.0            \
    active_window_opacity        1.0            \
    normal_window_opacity        0.90           \
    window_opacity               off            \
    insert_feedback_color        0xffd75f5f     \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    top_padding                  12             \
    bottom_padding               12             \
    left_padding                 12             \
    right_padding                12             \
    window_gap                   10             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

echo "yabai configuration loaded.."

# Center a lone tiled window at this width (in points) instead of letting it
# span the whole ultrawide. Displays that are not wide enough never center.
# Any change in the number of tiled windows on a space resizes some tiled
# window, so window_resized catches what has no signal of its own: mouse
# drops onto another display, windows leaving native fullscreen, windows sent
# to another space. Labels make a reload replace the signals instead of adding
# them twice.
#
# window_focused, application_front_switched and system_woke change no
# layout. They let a padding the other events left wrong last only until the
# next focus change. A run that finds every padding right writes nothing.
single_window_max_width=2080
if [ -x "$HOME/bin/yabai_center_single" ]; then
    for event in window_created window_destroyed window_minimized window_deminimized \
                 window_resized application_hidden application_visible space_changed \
                 mission_control_exit display_added display_removed display_resized \
                 window_focused application_front_switched system_woke; do
        yabai -m signal --add event="$event" label="center_single_$event" \
            action="$HOME/bin/yabai_center_single $single_window_max_width"
    done
    # The run that wins the lock keeps passing while the burst of
    # window_resized from yabai's start-up tiling marks it, so it runs in the
    # background and the rest of this file does not wait for it.
    "$HOME/bin/yabai_center_single" "$single_window_max_width" &
    echo "single window centering active"
else
    echo "yabai_center_single not found, single window centering off" >&2
fi

#borders active_color=0xffFFBF29 inactive_color=0x00000000 width=8.0 hidpi=on &
#borders active_color=0xFFD0A863 inactive_color=0x00000000 width=8.0 hidpi=on &
borders active_color=0xFFF3B23E inactive_color=0x00000000 width=8.0 hidpi=on &
echo "borders activated"
